@page
@model InvestIt.Pages.Transactions.RecentModel
@using InvestIt.Helpers
@{
    ViewData["Title"] = "Recent Transactions";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h2">Recent Transactions</h1>
                <a href="/" class="btn btn-secondary">Back to Dashboard</a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    @if (Model.Transactions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>TX Hash</th>
                                        <th>Wallet</th>
                                        <th>Network</th>
                                        <th>Type</th>
                                        <th>Token</th>
                                        <th>Amount</th>
                                        <th>USD Value</th>
                                        <th>From</th>
                                        <th>To</th>
                                        <th>Timestamp</th>
                                        <th>Block</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tx in Model.Transactions)
                                    {
                                        var typeClass = tx.Type == TransactionType.Buy ? "text-success" :
                                                       tx.Type == TransactionType.Sell ? "text-warning" : "text-info";
                                        <tr>
                                            <td>
                                                <code class="small">
                                                    @(tx.TxHash.Length > 16 ? $"{tx.TxHash.Substring(0, 8)}...{tx.TxHash.Substring(tx.TxHash.Length - 6)}" : tx.TxHash)
                                                </code>
                                            </td>
                                            <td>
                                                <a href="/Wallets/Details?id=@tx.WalletId">
                                                    @if (!string.IsNullOrEmpty(tx.Wallet.Label))
                                                    {
                                                        @tx.Wallet.Label
                                                    }
                                                    else
                                                    {
                                                        <code class="small">
                                                            @(tx.Wallet.Address.Length > 12 ? $"{tx.Wallet.Address.Substring(0, 6)}...{tx.Wallet.Address.Substring(tx.Wallet.Address.Length - 4)}" : tx.Wallet.Address)
                                                        </code>
                                                    }
                                                </a>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@tx.Wallet.BlockchainNetwork.Name</span>
                                            </td>
                                            <td class="@typeClass"><strong>@tx.Type</strong></td>
                                            <td>@tx.TokenSymbol</td>
                                            <td>@tx.Amount.ToString("N4")</td>
                                            <td>
                                                @if (tx.AmountUsd.HasValue)
                                                {
                                                    <text>$@tx.AmountUsd.Value.ToString("N2")</text>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </td>
                                            <td>
                                                <code class="small">
                                                    @(tx.FromAddress.Length > 12 ? $"{tx.FromAddress.Substring(0, 6)}...{tx.FromAddress.Substring(tx.FromAddress.Length - 4)}" : tx.FromAddress)
                                                </code>
                                            </td>
                                            <td>
                                                <code class="small">
                                                    @(tx.ToAddress.Length > 12 ? $"{tx.ToAddress.Substring(0, 6)}...{tx.ToAddress.Substring(tx.ToAddress.Length - 4)}" : tx.ToAddress)
                                                </code>
                                            </td>
                                            <td><small>@TimeZoneHelper.FormatCentral(tx.Timestamp)</small></td>
                                            <td>@tx.BlockNumber</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <h5>No transactions yet</h5>
                            <p class="mb-0">
                                Add wallets to start monitoring transactions across blockchains.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

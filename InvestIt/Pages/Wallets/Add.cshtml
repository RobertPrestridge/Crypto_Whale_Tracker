@page
@model InvestIt.Pages.Wallets.AddModel
@{
    ViewData["Title"] = "Add Wallet";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Add Wallet to Monitor</h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">Wallet Address</label>
                            <input asp-for="Address" class="form-control" placeholder="Enter wallet address" required />
                            <span asp-validation-for="Address" class="text-danger"></span>
                            <div class="form-text">
                                Enter the public wallet address you want to monitor
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BlockchainNetworkId" class="form-label">Blockchain Network</label>
                            <select asp-for="BlockchainNetworkId" asp-items="Model.Networks" class="form-select" required>
                                <option value="">Select a network...</option>
                            </select>
                            <span asp-validation-for="BlockchainNetworkId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Label" class="form-label">Label (Optional)</label>
                            <input asp-for="Label" class="form-control" placeholder="e.g., My Trading Wallet, Vitalik's Wallet" />
                            <span asp-validation-for="Label" class="text-danger"></span>
                            <div class="form-text">
                                Give this wallet a friendly name for easy identification
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">Add Wallet</button>
                            <a href="/Wallets/List" class="btn btn-secondary">Cancel</a>
                        </div>

                        <div asp-validation-summary="All" class="text-danger mt-3"></div>
                    </form>
                </div>
            </div>

            <div class="alert alert-info mt-3">
                <strong>Note:</strong> Once added, the wallet will be monitored every 30 seconds for new transactions.
                You'll receive real-time notifications when trades are detected.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@model InvestIt.Pages.Wallets.ListModel
@using InvestIt.Helpers
@{
    ViewData["Title"] = "Monitored Wallets";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h2">Monitored Wallets</h1>
                <a href="/Wallets/Add" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Add Wallet
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    @if (Model.Wallets.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Label</th>
                                        <th>Address</th>
                                        <th>Network</th>
                                        <th>Status</th>
                                        <th>Last Checked</th>
                                        <th>Added</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var wallet in Model.Wallets)
                                    {
                                        <tr>
                                            <td>
                                                @if (!string.IsNullOrEmpty(wallet.Label))
                                                {
                                                    <strong>@wallet.Label</strong>
                                                }
                                                else
                                                {
                                                    <em class="text-muted">No label</em>
                                                }
                                            </td>
                                            <td>
                                                <code>@wallet.Address</code>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@wallet.BlockchainNetwork.Name</span>
                                            </td>
                                            <td>
                                                @if (wallet.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                            </td>
                                            <td>
                                                @if (wallet.LastCheckedAt.HasValue)
                                                {
                                                    <small>@TimeZoneHelper.FormatCentral(wallet.LastCheckedAt.Value)</small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">Never</small>
                                                }
                                            </td>
                                            <td>
                                                <small>@TimeZoneHelper.FormatCentral(wallet.CreatedAt, "yyyy-MM-dd")</small>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="/Wallets/Details?id=@wallet.Id" class="btn btn-sm btn-outline-primary">
                                                        Details
                                                    </a>
                                                    <form method="post" asp-page-handler="ToggleActive" asp-route-id="@wallet.Id" class="d-inline">
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                            @(wallet.IsActive ? "Deactivate" : "Activate")
                                                        </button>
                                                    </form>
                                                    <form method="post" asp-page-handler="Delete" asp-route-id="@wallet.Id"
                                                          onsubmit="return confirm('Are you sure you want to delete this wallet?');" class="d-inline">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            Delete
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <h5>No wallets being monitored yet</h5>
                            <p class="mb-0">
                                Add a wallet to start monitoring transactions across multiple blockchains.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
